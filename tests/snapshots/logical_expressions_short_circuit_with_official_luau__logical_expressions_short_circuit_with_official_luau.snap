--!strict

local function produces_side_effect(): boolean
    print("called")
    return true
end

local function main(): ()
    const conjunction: boolean = false and produces_side_effect()
    const disjunction: boolean = true or produces_side_effect()
    print(conjunction)
    print(disjunction)
end

main()
