--!strict

type Profile = {
    name: string,
    score: number,
}

local function total(profile: Profile): number
    return profile.score
end

local function main(): ()
    const profile: Profile = {name = "Ada", score = 42}
    if ({name = "Ada", score = 42}).score == 42 then
        print(total(profile))
    else
        print(0)
    end
end

main()
