--!strict

local function select_value(enabled: boolean): number
    if enabled then
        const selected: number = 40
        return selected + 2
    else
        const fallback: number = 7
        return fallback
    end
end

local function main(): ()
    print(select_value(true))
    print(select_value(false))
end

main()
