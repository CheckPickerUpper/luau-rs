--!strict

local function main(): ()
    const grouped: number = (2 + 3) * 4
    const ordered: boolean = grouped >= 20 and grouped ~= 21
    const same_text: boolean = "luau" == "luau"
    const inverted: boolean = not false or same_text
    print(grouped)
    print(ordered)
    print(inverted)
end

main()
